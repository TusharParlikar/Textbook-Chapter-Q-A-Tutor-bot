# Copy to .env and edit. .env is gitignored; put real API keys there, never here.
# On Streamlit Cloud, put these in the app's Settings -> Secrets instead (KEY = "value" lines).

# Hosted LLM (any OpenAI-compatible API, e.g. Groq). Leave LLM_API_KEY empty to use local Ollama.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=120

OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PDF_PATH=data/your_book.pdf
