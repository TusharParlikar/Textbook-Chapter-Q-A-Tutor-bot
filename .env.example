# Copy to .env and edit. .env is gitignored; put real API keys there, never here.
# On Streamlit Cloud, put these in the app's Settings -> Secrets instead (same KEY = "value" lines).

# Set this to use Groq (needed on Streamlit Cloud); leave empty to use local Ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PDF_PATH=data/your_book.pdf
